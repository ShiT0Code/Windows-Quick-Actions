<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TouchHelper.SideBar.RightBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TouchHelper.SideBar"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Closed="Window_Closed">

    <Grid ManipulationMode="TranslateX,TranslateY"
          ManipulationStarting="Rectangle_ManipulationStarting"
          ManipulationDelta="Rectangle_ManipulationDelta"
          ManipulationCompleted="Rectangle_ManipulationCompleted"
          Tapped="Rectangle_Tapped"
          DoubleTapped="Rectangle_DoubleTapped"
          Background="Transparent">
        <Grid.RenderTransform>
            <TranslateTransform/>
        </Grid.RenderTransform>

        <Grid Width="4" Height="48" x:Name="rectangle" VerticalAlignment="Center"
              Background="{ThemeResource ButtonBackgroundThemeBrush}" HorizontalAlignment="Left"
              CornerRadius="2.5"
              RequestedTheme="Light">
            <Grid.OpacityTransition>
                <ScalarTransition/>
            </Grid.OpacityTransition>
        </Grid>
    </Grid>
</Window>
