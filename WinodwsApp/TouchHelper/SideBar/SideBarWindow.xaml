<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TouchHelper.SideBar.SideBarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TouchHelper.SideBar"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SideBarTargetWindow"
    Closed="Window_Closed">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop/>
    </Window.SystemBackdrop>

    <Grid Loaded="Grid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
        </Grid.ColumnDefinitions>

        <Grid Background="Transparent" Height="42" VerticalAlignment="Top"
              ManipulationMode="TranslateX" x:Name="titleBar"
              Grid.ColumnSpan="3"
              ManipulationCompleted="ManipulationCompleted">
            <Grid.RenderTransform>
                <TranslateTransform/>
            </Grid.RenderTransform>
            
            <TextBlock Text="侧边栏" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,6,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Height="36" Width="36"
                        Background="Transparent" BorderBrush="Transparent"
                        Padding="0" Margin="0,6,0,0">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="退出应用" Click="ExitApp_MenuFlyoutItem_Click"/>
                        </MenuFlyout>
                    </Button.Flyout>
                    <FontIcon Glyph="&#xE712;" />
                </Button>
                <AppBarButton Icon="Cancel" HorizontalContentAlignment="Right"
                      Height="46" Width="42" Click="Close_AppBarButton_Click"/>
            </StackPanel>
        </Grid>
        
        <Grid Background="Transparent" Width="14" x:Name="rectangle"
              ManipulationCompleted="ManipulationCompleted"
              DoubleTapped="Rectangle_DoubleTapped"
              ManipulationMode="TranslateX" Grid.Row="1">
            <Grid.RenderTransform>
                <TranslateTransform/>
            </Grid.RenderTransform>
            <Grid Width="4" Height="48" VerticalAlignment="Center"
              Margin="2,0,2,0"
              Background="{ThemeResource ButtonBackgroundThemeBrush}"
              CornerRadius="2.5"
              RequestedTheme="Light">
            </Grid>
        </Grid>

        <Frame Grid.Row="1" Grid.Column="1" x:Name="frame"/>
    </Grid>
</Window>